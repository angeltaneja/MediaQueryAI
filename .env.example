# MedQueryAI Environment Variables
# Copy this file to .env and fill in your keys

# ─── LLM Provider (choose one) ───
# Options: "gemini" (free), "groq" (free), "claude" (paid)
LLM_PROVIDER=gemini

# ─── API Keys (only need the one for your chosen provider) ───

# Google Gemini (FREE — get key at https://ai.google.dev)
GOOGLE_API_KEY=your_google_api_key_here

# Groq (FREE — get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (PAID — get key at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
